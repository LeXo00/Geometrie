                    <TextBox x:Name="txtInfoTriangle4" HorizontalAlignment="Left" Margin="182,430,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120" IsEnabled="False" Panel.ZIndex="1" Grid.Column="1"/>
