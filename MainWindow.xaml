                    <TextBox x:Name="txtRepEllipsePe" HorizontalAlignment="Left" Margin="80,374,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120" Panel.ZIndex="1" Grid.Column="1"/>
